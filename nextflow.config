manifest {
  name            = 'nf-austin/valis'
  author          = 'Austin Varela'
  homePage        = 'https://github.com/nf-austin/valis'
  description     = 'Automated whole slide image registration with VALIS (rigid + non-rigid), producing aligned ome.tiff slides'
  mainScript      = 'main.nf'
  nextflowVersion = '>=24.04.0'
  version         = '0.1.0'
  defaultBranch   = 'main'
}

params {
  // Input / output -- provide EITHER --input or --images.
  // Samplesheet CSV with columns: set (optional), image. Rows sharing a `set`
  // register together in row order; the FIRST row of each set is the reference.
  // This is the mode Seqera Platform launches with (nextflow_schema.json gives
  // it a file picker).
  input  = null
  // Ad-hoc alternative: ordered, comma-separated list of 2+ images.
  images = null
  name   = null      // set name; defaults to the reference basename
  outdir = "results"
  help   = false

  // Container images. Both are built from modules/run_valis/Dockerfile and
  // published by .github/workflows/docker.yml. Pinned rather than :latest so
  // runs stay reproducible; bump alongside manifest.version.
  valis_container_cpu = "ghcr.io/nf-austin/valis:0.1.0"
  valis_container_gpu = "ghcr.io/nf-austin/valis:0.1.0-cuda"
  valis_container     = null   // set to override both

  // GPU. Off by default; VALIS resolves the device at import time, so the
  // process forces CPU via CUDA_VISIBLE_DEVICES rather than an argument.
  use_gpu = false

  // Registration
  crop                  = "reference"  // "reference" | "overlap" | "all"
  check_for_reflections = true         // handles mirrored/flipped inputs; off upstream
  imgs_ordered          = false        // true = trust --images order as the z-stack order
  create_masks          = true         // false if VALIS's multi-Otsu masking fails on uniform slides
  micro_reg             = true         // second, higher-resolution non-rigid pass
  merge                 = true         // also write a merged multi-channel OME-TIFF

  // Non-rigid registrar (class name from valis.non_rigid_registrars).
  // OpticalFlowWarper is CPU-only; RAFTWarper is the only GPU-capable one, so
  // --use_gpu switches to it -- otherwise the GPU would only accelerate feature
  // detection on 512px thumbnails while every expensive stage stayed on CPU.
  non_rigid_registrar     = "OpticalFlowWarper"
  non_rigid_registrar_gpu = "RAFTWarper"

  // Working resolutions. These cap the registration working size, independent
  // of the full-resolution warp. Note VALIS silently raises max_image_dim_px to
  // match if it is smaller than max_processed_image_dim_px.
  max_processed_image_dim_px         = 512
  max_non_rigid_registration_dim_px  = 2048
  micro_max_dim_px                   = 4096   // must exceed the value above

  valis_compression = null   // OME-TIFF codec override; VALIS defaults to DEFLATE

  // Resource caps (applied via process.resourceLimits below). Use Nextflow
  // unit literals (.GB, .h) so values stay typed as MemoryUnit / Duration.
  max_memory = 128.GB
  max_cpus   = 32
  max_time   = 72.h
}

process {
  // Nextflow 24.04+ enforces these caps automatically on every task.
  resourceLimits = [
    memory: params.max_memory,
    cpus  : params.max_cpus,
    time  : params.max_time
  ]

  withName: 'SUMMARY_REPORT' {
    cpus          = 1
    memory        = { workflow.stubRun ? 1.GB : 4.GB * task.attempt }
    time          = { 30.m * task.attempt }
    errorStrategy = 'retry'
    maxRetries    = 2
  }

  withName: 'RUN_VALIS' {
    // -stub-run touches no image data, so it must not demand a big node --
    // otherwise validating the wiring fails on any laptop with "Process
    // requirement exceeds available CPUs".
    cpus          = { workflow.stubRun ? 1 : 16 * task.attempt }
    memory        = { workflow.stubRun ? 1.GB : 64.GB * task.attempt }
    time          = { workflow.stubRun ? 10.m : 24.h * task.attempt }
    errorStrategy = 'retry'
    maxRetries    = 2
    // Closure so no accelerator is requested unless GPU mode is on -- an
    // unconditional directive would ask every executor for a GPU it may not
    // have.
    accelerator   = { params.use_gpu ? 1 : null }
  }
}

// Execution reports. Seqera Platform renders these, and they are the first
// thing to look at when a run misbehaves. overwrite so -resume does not fail on
// a pre-existing file.
report {
  enabled   = true
  overwrite = true
  file      = "${params.outdir}/pipeline_info/execution_report.html"
}
timeline {
  enabled   = true
  overwrite = true
  file      = "${params.outdir}/pipeline_info/execution_timeline.html"
}
trace {
  enabled   = true
  overwrite = true
  file      = "${params.outdir}/pipeline_info/execution_trace.txt"
}
dag {
  enabled   = true
  overwrite = true
  file      = "${params.outdir}/pipeline_info/pipeline_dag.html"
}

profiles {
  docker {
    docker.enabled       = true
    docker.userEmulation = true
    singularity.enabled  = false
    conda.enabled        = false
  }
  singularity {
    singularity.enabled    = true
    singularity.autoMounts = true
    docker.enabled         = false
    conda.enabled          = true
  }
  conda {
    // Not a supported path for this pipeline: RUN_VALIS resolves through a
    // container directive, which conda-only mode does not honor. Kept for
    // parity with the sibling pipelines.
    conda.enabled       = true
    docker.enabled      = false
    singularity.enabled = false
  }
}
